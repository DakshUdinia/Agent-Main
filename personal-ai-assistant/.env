# ─── OpenAI API Keys (comma-separated, rotates on quota exhaustion) ───────────
OPENAI_API_KEYS=sk-openai-key1,sk-openai-key2

# ─── Gemini API Keys (Google AI Studio) ───────────────────────────────────────
GEMINI_API_KEYS=AIza-gemini-key1,AIza-gemini-key2

# ─── OpenRouter API Keys ───────────────────────────────────────────────────────
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2

# ─── Groq API Keys ────────────────────────────────────────────────────────────
GROQ_API_KEYS=gsk_groq-key1,gsk_groq-key2

# ─── Provider priority order (tries each provider in sequence) ────────────────
# Options: openai, gemini, openrouter, groq
PROVIDER_ORDER=openai,gemini,groq,openrouter

# ─── Chat Platform Tokens ─────────────────────────────────────────────────────
TELEGRAM_TOKEN=
DISCORD_TOKEN=
WHATSAPP_ENABLED=false

# ─── Voice Settings ───────────────────────────────────────────────────────────
VOICE_ENABLED=false
